[
  {
    "name": "attribute values are typed: a bare number, a boolean, a flag, a bare word",
    "geml": "=== note {#n .a .b caption=\"Hi there\" n=3 neg=-1 f=1.5 e=1e3 dot=.5 t=true fa=false flag word=bare}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n.a.b{\"caption\":\"Hi there\",\"dot\":0.5,\"e\":1000,\"f\":1.5,\"fa\":false,\"flag\":true,\"n\":3,\"neg\":-1,\"t\":true,\"word\":\"bare\"}[p(\"x\")]",
    "diagnostics": [
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning",
      "unknown-attribute:warning"
    ]
  },
  {
    "name": "a quoted value is always a string",
    "geml": "=== note {#n n=\"3\" t=\"true\"}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"n\":\"3\",\"t\":\"true\"}[p(\"x\")]"
  },
  {
    "name": "a quoted value escapes only \" and \\",
    "geml": "=== note {#n caption=\"say \\\"hi\\\" \\\\ \\n ok\"}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"say \\\"hi\\\" \\\\ \\\\n ok\"}[p(\"x\")]"
  },
  {
    "name": "a bare word that is not number syntax is a string",
    "geml": "=== note {#n v=1.2.3 x=0x1f p=+5 q=1_000 r=5.}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"p\":5,\"q\":\"1_000\",\"r\":5,\"v\":\"1.2.3\",\"x\":\"0x1f\"}[p(\"x\")]"
  },
  {
    "name": "attribute order is not significant",
    "geml": "=== note {word=b #n flag .c}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n.c{\"flag\":true,\"word\":\"b\"}[p(\"x\")]"
  },
  {
    "name": "a `\\` continuation folds an attribute object across lines",
    "geml": "=== note {#n \\\n    caption=\"a\" \\\n    n=2}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"a\",\"n\":2}[p(\"x\")]"
  },
  {
    "name": "a NAME written twice in one attribute object is an error",
    "geml": "=== note {#n k=1 k=2}\nx\n===\n",
    "want": "block:note",
    "diagnostics": [
      "duplicate-name:error",
      "unknown-attribute:warning"
    ]
  },
  {
    "name": "a key a type does not define is a warning, and is kept",
    "geml": "=== code {#c lang=sh colour=red}\nx\n===\n",
    "want": "block:code",
    "blocks": "code#c{\"colour\":\"red\",\"lang\":\"sh\"}(\"x\")",
    "diagnostics": [
      "unknown-attribute:warning"
    ]
  },
  {
    "name": "`hidden` is a flag on every typed block",
    "geml": "=== note {#n hidden}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"hidden\":true}[p(\"x\")]"
  },
  {
    "name": "a flow body holds prose and nested blocks",
    "geml": "==== note {#outer}\npara\n\n=== note {#inner}\ny\n===\n====\n",
    "want": "block:note",
    "blocks": "note#outer[p(\"para\") note#inner[p(\"y\")]]",
    "ids": [
      "outer",
      "inner"
    ]
  },
  {
    "name": "three levels nest by fence length",
    "geml": "===== note {#a}\n==== note {#b}\n=== note {#c}\nz\n===\n====\n=====\n",
    "want": "block:note",
    "blocks": "note#a[note#b[note#c[p(\"z\")]]]",
    "ids": [
      "a",
      "b",
      "c"
    ]
  },
  {
    "name": "a raw body is verbatim: a fence inside it is text, and defines no id",
    "geml": "==== code {#c}\n=== note {#x}\nz\n===\n====\n",
    "want": "block:code",
    "blocks": "code#c(\"=== note {#x}\\nz\\n===\")",
    "ids": [
      "c"
    ]
  },
  {
    "name": "a `%%` line in a flow body is hidden; in a raw body it is text",
    "geml": "==== note {#n}\n%% a note to self\nvisible\n=== code {#c}\n%% kept\n===\n====\n",
    "want": "block:note",
    "blocks": "note#n[hidden p(\"visible\") code#c(\"%% kept\")]"
  },
  {
    "name": "a labeled close closes its own block",
    "geml": "=== note {#a}\nx\n=== #a\n",
    "want": "block:note",
    "blocks": "note#a[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a bare close inside a labeled block still closes it; the labeled close after it is stray",
    "geml": "=== code {#c}\na\n===\nb\n=== #c\n",
    "want": "block:code \"b\\n=== #c\"",
    "blocks": "code#c(\"a\") p(\"b\\n=== #c\")",
    "diagnostics": [
      "stray-labeled-fence:warning"
    ]
  },
  {
    "name": "an unterminated block runs to the end of the document",
    "geml": "=== note {#n}\nx\n",
    "want": "block:note",
    "blocks": "note#n[p(\"x\")]",
    "diagnostics": [
      "unterminated-block:error"
    ]
  },
  {
    "name": "a `text` block's body is prose",
    "geml": "=== text {#t}\nphrase *one*\n\nphrase two\n===\n",
    "want": "block:text",
    "blocks": "text#t[p(\"phrase \" em(\"one\")) p(\"phrase two\")]"
  },
  {
    "name": "an unknown type keeps its body verbatim",
    "geml": "=== acme-chart {#a}\n*not emphasis*\n===\n",
    "want": "block:acme-chart",
    "blocks": "acme-chart#a(\"*not emphasis*\")",
    "diagnostics": [
      "unknown-block-type:warning"
    ]
  },
  {
    "name": "a ``` pair inside a flow body shields its lines; the block after the body is a block",
    "geml": "==== note {#outer}\n```\n=== note {#inner}\nx\n===\n```\n====\n\n=== note {#after}\ny\n===\n",
    "want": "block:note block:note",
    "blocks": "note#outer[p(code(\"\\n=== note {#inner}\\nx\\n===\\n\"))] note#after[p(\"y\")]",
    "ids": [
      "outer",
      "after"
    ]
  },
  {
    "name": "a meta block holds the keys it defines",
    "geml": "=== meta\ntitle = \"t\"\nn = 3\nok = true\n===\n",
    "want": "",
    "blocks": "meta({\"n\":3,\"ok\":true,\"title\":\"t\"})"
  },
  {
    "name": "a heading carries its derived id in the tree",
    "geml": "# Use `x` here\n\ntext\n",
    "want": "h1(\"Use \" code(\"x\") \" here\") \"text\"",
    "blocks": "h1#use-here(\"Use \" code(\"x\") \" here\") p(\"text\")"
  },
  {
    "name": "a bare value may hold a quoted span: a coordinate in src= needs no outer quotes",
    "geml": "=== data {#d}\n{\"a\": 1}\n===\n\n=== embed {src=#d[\"a\"]}\n===\n",
    "want": "data({\"a\":1}) embed(\"#d[\\\"a\\\"]\")",
    "blocks": "data#d(\"{\\\"a\\\": 1}\") embed{\"src\":\"#d[\\\"a\\\"]\"}(\"\")",
    "diagnostics": []
  },
  {
    "name": "whitespace inside a quoted span does not end a bare word, and the word keeps its quotes",
    "geml": "=== note {#n caption=a\"b c\"d}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"a\\\"b c\\\"d\"}[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a value is a quoted string only when it begins and ends with a quote; otherwise a bare word, verbatim",
    "geml": "=== note {#n caption=\"a b\"c}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"\\\"a b\\\"c\"}[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a quoted span left open runs to the end of the object",
    "geml": "=== note {#n caption=\"a b}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"\\\"a b\"}[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "on a fence line the object runs to the last brace: a brace between is an ordinary character",
    "geml": "=== note {#n caption=a}b}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"a}b\"}[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a second brace group on a fence line belongs to the one object",
    "geml": "=== note {#a} {x=1}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#a}{\"{x\":1}[p(\"x\")]",
    "diagnostics": [
      "name-not-a-name:warning",
      "name-not-a-name:warning",
      "unknown-attribute:warning"
    ]
  },
  {
    "name": "any White_Space separates items, an ideographic space included",
    "geml": "=== note {#a　.b}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#a.b[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a fold turns the backslash, the newline and the whitespace around them into one space, inside a quoted value too",
    "geml": "=== note {#n caption=\"p \\\n      q\"}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"p q\"}[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "a heading's object is the nearest group left of its final brace, preceded by whitespace",
    "geml": "## T {x {#h}\n",
    "want": "h2(\"T {x\")",
    "blocks": "h2#h(\"T {x\")",
    "diagnostics": []
  },
  {
    "name": "a quoted brace inside a heading's object does not end it",
    "geml": "## T {#h caption=\"a}b\"}\n",
    "want": "h2(\"T\")",
    "blocks": "h2#h(\"T\")",
    "diagnostics": []
  },
  {
    "name": "a group glued to the heading text is not an object",
    "geml": "## Title{#a}\n",
    "want": "h2(\"Title{#a}\")",
    "blocks": "h2#titlea(\"Title{#a}\")",
    "diagnostics": []
  },
  {
    "name": "a brace met before the opening one leaves a heading without an object",
    "geml": "## a {b}x}\n",
    "want": "h2(\"a {b}x}\")",
    "blocks": "h2#a-bx(\"a {b}x}\")",
    "diagnostics": []
  },
  {
    "name": "braces and quotes in a heading's text before its object stay text",
    "geml": "## Set {a, b} of 5\" pipes {#sets}\n",
    "want": "h2(\"Set {a, b} of 5\\\" pipes\")",
    "blocks": "h2#sets(\"Set {a, b} of 5\\\" pipes\")",
    "diagnostics": []
  },
  {
    "name": "a brace inside a code span of a heading opens no object",
    "geml": "## a `x {` y}\n",
    "want": "h2(\"a \" code(\"x {\") \" y}\")",
    "blocks": "h2#a-y(\"a \" code(\"x {\") \" y}\")",
    "diagnostics": []
  },
  {
    "name": "a heading whose whole text is an object has empty text",
    "geml": "## {#a}\n",
    "want": "h2()",
    "blocks": "h2#a()",
    "diagnostics": []
  },
  {
    "name": "a key written twice is the duplicate-name error, and the first value is the one read",
    "geml": "=== note {#n caption=a caption=b}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#n{\"caption\":\"a\"}[p(\"x\")]",
    "diagnostics": [
      "duplicate-name:error"
    ]
  },
  {
    "name": "of two ids in one object the first is the id",
    "geml": "=== note {#a #b}\nx\n===\n",
    "want": "block:note",
    "blocks": "note#a[p(\"x\")]",
    "diagnostics": []
  },
  {
    "name": "table: a header-less data form",
    "geml": "=== table {#t format=csv header=0}\nx, y\n1, 2\n===\n",
    "want": "table([\"A\",\"B\"] [\"x\",\"y\"] [\"1\",\"2\"])"
  },
  {
    "name": "table: a pipe grid with no separator row",
    "geml": "=== table {#t}\n| x | y |\n| 1 | 2 |\n===\n",
    "want": "table([\"A\",\"B\"] [\"x\",\"y\"] [\"1\",\"2\"])"
  },
  {
    "name": "table: a pipe grid without its outer pipes",
    "geml": "=== table {#t}\nx | y\n--|--\n1 | 2\n===\n",
    "want": "table([\"x\",\"y\"] [\"1\",\"2\"])"
  },
  {
    "name": "table: a separator row first: no header",
    "geml": "=== table {#t}\n|---|:-:|\n| 1 | 2 |\n===\n",
    "want": "table([\"A\",\"B\"] [\"1\",\"2\"])"
  },
  {
    "name": "table: the header is the row just above the separator",
    "geml": "=== table {#t}\n| a | b |\n| x | y |\n|---|---|\n| 1 | 2 |\n===\n",
    "want": "table([\"x\",\"y\"] [\"1\",\"2\"])"
  },
  {
    "name": "table: a second separator-like row is a body row",
    "geml": "=== table {#t}\n| x | y |\n|---|---|\n| 1 | 2 |\n|---|---|\n| 3 | 4 |\n===\n",
    "want": "table([\"x\",\"y\"] [\"1\",\"2\"] [\"---\",\"---\"] [\"3\",\"4\"])"
  },
  {
    "name": "table: a separator row over no rows",
    "geml": "=== table {#t}\n|---|:-:|---:|\n===\n",
    "want": "table([\"A\",\"B\",\"C\"])"
  }
]

[
  {
    "name": "em",
    "geml": "*x*",
    "want": "em(\"x\")"
  },
  {
    "name": "strong",
    "geml": "**x**",
    "want": "strong(\"x\")"
  },
  {
    "name": "strike",
    "geml": "~~x~~",
    "want": "s(\"x\")"
  },
  {
    "name": "all three",
    "geml": "*a* **b** ~~c~~",
    "want": "em(\"a\") \" \" strong(\"b\") \" \" s(\"c\")"
  },
  {
    "name": "intraword em",
    "geml": "a*b*c",
    "want": "\"a\" em(\"b\") \"c\""
  },
  {
    "name": "em inside strong",
    "geml": "**a *b* c**",
    "want": "strong(\"a \" em(\"b\") \" c\")"
  },
  {
    "name": "strong inside em",
    "geml": "*a **b** c*",
    "want": "em(\"a \" strong(\"b\") \" c\")"
  },
  {
    "name": "triple is em+strong",
    "geml": "***x***",
    "want": "em(strong(\"x\"))"
  },
  {
    "name": "em then strong",
    "geml": "*a***b**",
    "want": "em(\"a\") strong(\"b\")"
  },
  {
    "name": "unpaired inner star is literal",
    "geml": "**a*b**",
    "want": "strong(\"a*b\")"
  },
  {
    "name": "strong nested mid-em",
    "geml": "*foo**bar**baz*",
    "want": "em(\"foo\" strong(\"bar\") \"baz\")"
  },
  {
    "name": "em nested mid-strong",
    "geml": "**foo*bar*baz**",
    "want": "strong(\"foo\" em(\"bar\") \"baz\")"
  },
  {
    "name": "spaced stars are literal",
    "geml": "a ** b ** c",
    "want": "\"a ** b ** c\""
  },
  {
    "name": "opener-only star is literal",
    "geml": "*a",
    "want": "\"*a\""
  },
  {
    "name": "lone tilde is literal",
    "geml": "~lone~",
    "want": "\"~lone~\""
  },
  {
    "name": "unterminated strong is literal",
    "geml": "**nope",
    "want": "\"**nope\""
  },
  {
    "name": "punctuation-flanked em",
    "geml": "f(*x*)",
    "want": "\"f(\" em(\"x\") \")\""
  },
  {
    "name": "underscore is literal in GEML",
    "geml": "foo_bar_baz",
    "want": "\"foo_bar_baz\""
  },
  {
    "name": "nested em in strong with text",
    "geml": "**strong *and em* together**",
    "want": "strong(\"strong \" em(\"and em\") \" together\")"
  },
  {
    "name": "emphasis crosses a code atom (GEP-0007)",
    "geml": "*em with `code` inside*",
    "want": "em(\"em with \" code(\"code\") \" inside\")"
  },
  {
    "name": "escaped star is literal",
    "geml": "a\\*b",
    "want": "\"a*b\""
  },
  {
    "name": "double-strike",
    "geml": "~~a ~~b~~ c~~",
    "want": "s(\"a \" s(\"b\") \" c\")"
  },
  {
    "name": "quad star nests strong",
    "geml": "****x****",
    "want": "strong(strong(\"x\"))"
  },
  {
    "name": "double-star inside single",
    "geml": "*a**b*",
    "want": "em(\"a**b\")"
  },
  {
    "name": "triple inside double-close",
    "geml": "a ***b*** c",
    "want": "\"a \" em(strong(\"b\")) \" c\""
  },
  {
    "name": "two separate em",
    "geml": "*a* *b*",
    "want": "em(\"a\") \" \" em(\"b\")"
  },
  {
    "name": "strike wraps em",
    "geml": "~~a *b* c~~",
    "want": "s(\"a \" em(\"b\") \" c\")"
  },
  {
    "name": "rule-of-three reject",
    "geml": "*a**",
    "want": "em(\"a\") \"*\""
  },
  {
    "name": "five stars",
    "geml": "*****x*****",
    "want": "em(strong(strong(\"x\")))"
  },
  {
    "name": "em adjacent strong",
    "geml": "*a***b***c*",
    "want": "em(\"a\") strong(\"b\") em(\"c\")"
  },
  {
    "name": "star before punctuation",
    "geml": "**(x)**",
    "want": "strong(\"(x)\")"
  },
  {
    "name": "mixed star tilde",
    "geml": "*a ~~b~~ c*",
    "want": "em(\"a \" s(\"b\") \" c\")"
  },
  {
    "name": "flanking: CJK quote outside, ASCII punctuation inside",
    "geml": "“*(foo)*”",
    "want": "\"“\" em(\"(foo)\") \"”\""
  },
  {
    "name": "flanking: CJK quotes around emphasized text",
    "geml": "他说“*强调*”。",
    "want": "\"他说“\" em(\"强调\") \"”。\""
  },
  {
    "name": "flanking: full-width parentheses are punctuation",
    "geml": "（**重点**）",
    "want": "\"（\" strong(\"重点\") \"）\""
  },
  {
    "name": "flanking: CJK comma before a closing run",
    "geml": "*甲*，*乙*",
    "want": "em(\"甲\") \"，\" em(\"乙\")"
  },
  {
    "name": "emphasis crosses a link atom (GEP-0007)",
    "geml": "*a [b](x.geml) c*",
    "want": "em(\"a \" link(\"x.geml\" \"b\") \" c\")"
  },
  {
    "name": "strong crosses a code atom",
    "geml": "**a `b` c**",
    "want": "strong(\"a \" code(\"b\") \" c\")"
  },
  {
    "name": "emphasis crosses inline math",
    "geml": "*a $x$ c*",
    "want": "em(\"a \" math(\"x\") \" c\")"
  },
  {
    "name": "emphasis crosses an image atom",
    "geml": "*a ![pic](i.png) c*",
    "want": "em(\"a \" img(\"i.png\") \" c\")"
  },
  {
    "name": "strikethrough crosses a link atom",
    "geml": "~~a [b](x.geml) c~~",
    "want": "s(\"a \" link(\"x.geml\" \"b\") \" c\")"
  },
  {
    "name": "two separate emphases do not merge across a link",
    "geml": "*a* [b](x.geml) *c*",
    "want": "em(\"a\") \" \" link(\"x.geml\" \"b\") \" \" em(\"c\")"
  },
  {
    "name": "intraword star before an atom stays literal (flanking)",
    "geml": "a*[b](x.geml)*a",
    "want": "\"a*\" link(\"x.geml\" \"b\") \"*a\""
  },
  {
    "name": "an unpaired opener before an atom stays literal",
    "geml": "*a [b](x.geml)",
    "want": "\"*a \" link(\"x.geml\" \"b\")"
  },
  {
    "name": "emphasis of a bare link",
    "geml": "*[b](x.geml)*",
    "want": "em(link(\"x.geml\" \"b\"))"
  },
  {
    "name": "strong of a bare link",
    "geml": "**[b](x.geml)**",
    "want": "strong(link(\"x.geml\" \"b\"))"
  },
  {
    "name": "a closer directly after an atom cannot close into a word",
    "geml": "*[b](x.geml)*word",
    "want": "\"*\" link(\"x.geml\" \"b\") \"*word\""
  },
  {
    "name": "a run between two atoms flanks on the atoms' edge characters",
    "geml": "`a`*x*`b`",
    "want": "code(\"a\") em(\"x\") code(\"b\")"
  },
  {
    "name": "escaped star inside emphasis is content",
    "geml": "*foo\\*bar*",
    "want": "em(\"foo*bar\")"
  },
  {
    "name": "an escaped star before an opener does not join the run",
    "geml": "\\**foo*",
    "want": "\"*\" em(\"foo\")"
  },
  {
    "name": "emphasis may end just after an escaped star",
    "geml": "*foo\\**",
    "want": "em(\"foo*\")"
  },
  {
    "name": "emphasis spans a hard line break",
    "geml": "*a\\\nb*",
    "want": "em(\"a\" br \"b\")"
  },
  {
    "name": "auto-reference inside emphasis",
    "geml": "# X {#x}\n\n*see [[#x]] now*",
    "want": "h1(\"X\") em(\"see \" ref(\"#x\") \" now\")"
  },
  {
    "name": "footnote marker inside emphasis",
    "geml": "*a [^n] b*\n\n=== note {#n}\nN\n===",
    "want": "em(\"a \" fn(\"n\") \" b\") block:note"
  },
  {
    "name": "inline projection inside emphasis",
    "geml": "=== text {#p}\nP\n===\n\n*a ![[#p]] b*",
    "want": "block:text em(\"a \" project(\"#p\") \" b\")"
  },
  {
    "name": "triple stars across an atom nest em in strong",
    "geml": "***a `b` c***",
    "want": "em(strong(\"a \" code(\"b\") \" c\"))"
  },
  {
    "name": "adjacent atoms wrap as one emphasis",
    "geml": "*`a``b`*",
    "want": "em(code(\"a\") code(\"b\"))"
  },
  {
    "name": "a star inside a code span never pairs outward",
    "geml": "*a `x*y` b*",
    "want": "em(\"a \" code(\"x*y\") \" b\")"
  },
  {
    "name": "strong across a link with a trailing nested em (rule of three)",
    "geml": "**bold [b](x.geml) *and em***",
    "want": "strong(\"bold \" link(\"x.geml\" \"b\") \" \" em(\"and em\"))"
  },
  {
    "name": "strikethrough crosses a code atom",
    "geml": "~~del `x`~~",
    "want": "s(\"del \" code(\"x\"))"
  },
  {
    "name": "emphasis inside a link label stays scoped to the label",
    "geml": "*foo [bar *baz* qux](x.geml) end*",
    "want": "em(\"foo \" link(\"x.geml\" \"bar \" em(\"baz\") \" qux\") \" end\")"
  },
  {
    "name": "a spent tilde run leaves literal tildes, never re-pairing (no hang)",
    "geml": "~~~a~~~",
    "want": "\"~\" s(\"a\") \"~\""
  },
  {
    "name": "an over-long tilde run spends two per side and leaves the rest literal",
    "geml": "~~~~a~~~",
    "want": "\"~~\" s(\"a\") \"~\""
  }
]

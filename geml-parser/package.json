{
  "name": "@geml/geml",
  "version": "1.9.2",
  "mcpName": "io.github.geml-spec/geml",
  "publishConfig": {
    "access": "public"
  },
  "description": "Read and edit long Markdown by block instead of by file — geml list/find/get address any .md, nothing is converted. Plus GEML, a plain-text format where blocks carry ids for validated writes, reference checks and per-block history. Ships an MCP server.",
  "type": "module",
  "bin": {
    "geml": "dist/cli.js"
  },
  "main": "dist/geml.js",
  "types": "dist/geml.d.ts",
  "files": [
    "dist",
    "codemap",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "geml",
    "general expressive markup language",
    "mcp",
    "mcp-server",
    "markup",
    "markdown",
    "parser",
    "cli",
    "document",
    "typed-block",
    "ai",
    "agent",
    "llm",
    "addressable",
    "versioning",
    "docs",
    "code-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geml-spec/geml.git",
    "directory": "geml-parser"
  },
  "homepage": "https://github.com/geml-spec/geml#readme",
  "bugs": {
    "url": "https://github.com/geml-spec/geml/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node test/all.mjs",
    "parse": "node dist/geml.js",
    "coverage": "tsc && c8 --all --include=dist/**/*.js --include=codemap/**/*.mjs --reporter=text --reporter=text-summary node test/all.mjs",
    "coverage:check": "tsc && c8 --all --include=dist/**/*.js --include=codemap/**/*.mjs --check-coverage --lines 95 --statements 95 --functions 95 --branches 95 node test/all.mjs",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.21",
    "c8": "^10.1.3",
    "typescript": "^5.9.3"
  }
}

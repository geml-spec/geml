# Local-only working files, not part of the published repo.
.claude/launch.json
.code-review-graph/
.geml-code-graph/

integrations/langchain+llamaindex/__pycache__

# Python build metadata, written by `pip install -e .` (regenerable)
*.egg-info/

# GEML history sidecars under .claude are local working state (git already versions the .geml)
.claude/**/*.gemlhistory

#node generated
**/node_modules/
**/dist/

# wrangler local cache (a `wrangler dev`/`deploy --dry-run` run from the repo root leaves one here)
.wrangler/

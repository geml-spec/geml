          "#meta",
          "#look"
        ]
      }
    },
    {
      "name": "a clip carries its attributes on its own type",
      "geml": "=== meta\nprofile = \"geml-media/v1\"\n===\n\n=== media-clip {#c1 track=video src=lib.geml#a1 in=0 out=4}\n===\n",

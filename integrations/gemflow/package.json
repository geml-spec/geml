{
  "name": "@geml/gemflow",
  "version": "0.2.47",
  "description": "Gemflow: GEML workflows for coding agents — stages, signals and a journal per work item. A Claude Code plugin (a band above the prompt, a board), DeepSeek Harness and Pi adapters, an MCP server for other hosts, and a CLI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gemflow": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/geml-spec/geml",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geml-spec/geml.git",
    "directory": "integrations/gemflow"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "pi-package",
    "pi",
    "geml",
    "agent",
    "statechart",
    "state-machine",
    "journal",
    "mcp"
  ],
  "files": ["dist", "spec", "skills", "examples", "workflows", ".claude-plugin/plugin.json", "hooks", "types", "cordis.patch.yml", "LICENSE", ".codex-plugin/plugin.json", "codex", ".codexignore", "client.js"],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:claude": "npm run build && claude plugin validate . && claude plugin test .",
    "pack:local": "node scripts/pack-local.mjs",
    "walkthrough": "node examples/walkthrough.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "dependencies": {
    "@geml/geml": "file:../../geml-parser"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.0",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/hosts/dsh/plugin.d.ts",
      "default": "./dist/hosts/dsh/plugin.js"
    },
    "./pi": {
      "types": "./dist/hosts/pi/extension.d.ts",
      "default": "./dist/hosts/pi/extension.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/hosts/pi/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}

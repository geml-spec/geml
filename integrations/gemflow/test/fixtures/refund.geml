=== meta
title   = "Refund approval"
profile = "geml-statechart/v1"
===

=== diagram {#flow format=geml-statechart caption="Refund approval"}
{
  "initial": "intake",
  "states": {
    "intake": { "title": "Intake", "description": "Collect the order id and the refund amount from the user. Do not judge yet." },
    "review": { "title": "Review", "description": "Check the order against the refund policy; set approved, then move on.", "prompt": "#policy" },
    "pay": { "title": "Pay", "description": "Execute the refund exactly once.", "rules": ["refund"] },
    "wait-human": { "title": "Wait for a person", "description": "Amounts above the threshold need a human. Nothing to do until they answer." },
    "done": { "title": "Done", "description": "Summarize what happened and stop.", "final": true }
  },
  "vars": {
    "order":    { "default": "", "note": "Order id" },
    "amount":   { "default": 0 },
    "approved": { "default": false }
  },
  "transitions": [
    { "from": "intake", "to": "review", "guard": "the order id and the amount are known" },
    { "from": "review", "to": "pay",
      "guard": { "properties": { "approved": { "const": true } } },
      "approval": true,
      "note": "Policy allows the refund; a person approves this step." },
    { "from": "review", "to": "wait-human", "guard": "the amount is above the threshold" },
    { "from": "wait-human", "to": "pay",
      "guard": { "properties": { "approved": { "const": true } } },
      "note": "The person confirmed." },
    { "from": "pay", "to": "done", "note": "The refund went through." }
  ]
}
===

## Refund policy {#policy}

Refunds under 200 need no approval. Above that, a human confirms.
